VITE_SUPABASE_URL="https://PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-or-publishable-key"

# Optional. The Google OAuth client id (the one set on Supabase's Google
# provider). With it, Google's sign-in screen names this site instead of the
# Supabase project. The site must be an authorised JavaScript origin of that
# client in Google Cloud.
# VITE_GOOGLE_CLIENT_ID="1234-abc.apps.googleusercontent.com"

# Optional. A path on this site that forwards to the Supabase project, for
# visitors whose network can't reach supabase.co reliably. The Vercel build
# sets it to "/supabase" and forwards that path (see vercel.json); the dev
# server forwards it too.
# VITE_SUPABASE_PROXY="/supabase"
