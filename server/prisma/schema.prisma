generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// The id is the Supabase auth user id, so there is no password here:
// signing in is handled entirely by Supabase.
model User {
  id           String   @id
  email        String   @unique
  username     String   @unique
  name         String
  // A small JPEG the browser has already cropped and resized.
  avatar          Bytes?
  avatarUpdatedAt DateTime?
  bio          String?
  // Free-form tags like "rust" or "postgres", shown on the profile.
  stack        String[] @default([])
  location     String?
  link         String?
  // Off by default: turns on the commitment page anyone can open without an
  // account, at /c/<username>.
  sharePublic  Boolean  @default(false)
  // Admins can look through everyone's proof photos, and nothing else extra.
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())
  arcs         Arc[]
  reactions        Reaction[]
  pushSubscriptions PushSubscription[]
  sentRequests     Friendship[] @relation("requester")
  receivedRequests Friendship[] @relation("addressee")
}

// Dates are stored as "YYYY-MM-DD" strings in the user's local calendar,
// so a "day" means the same thing regardless of server timezone.
model Arc {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  startDate String
  endDate   String
  createdAt DateTime @default(now())
  tracks    Track[]
  reflections Reflection[]

  @@index([userId, createdAt])
}

// One line a day on how it went. Only ever shown to the arc's owner.
model Reflection {
  id        String   @id @default(cuid())
  arcId     String
  arc       Arc      @relation(fields: [arcId], references: [id], onDelete: Cascade)
  date      String
  text      String
  createdAt DateTime @default(now())

  @@unique([arcId, date])
}

// A track is one vertical inside an arc: "Web Dev", "DSA", "Badminton".
// Private tracks are only ever shown to their owner.
//
// Each day a track runs, its task is whichever checkpoint is first in line and
// not yet finished. Check-ins hang off a single Goal row per track, created
// with it, which is what the streak maths counts.
model Track {
  id        String   @id @default(cuid())
  arcId     String
  arc       Arc      @relation(fields: [arcId], references: [id], onDelete: Cascade)
  name      String
  isPublic  Boolean  @default(true)
  // The plan for this track: which weekdays it runs on (0 = Sunday) and how
  // long a session is. Its goals only count on those days.
  days      Int[]    @default([0, 1, 2, 3, 4, 5, 6])
  minutes   Int      @default(60)
  // "HH:MM" local time, and how many minutes before it to be reminded.
  // Both only matter for the calendar export.
  startTime String?
  reminder  Int?
  createdAt DateTime @default(now())
  goals     Goal[]
  checkpoints Checkpoint[]

  @@index([arcId])
}

// A one-off milestone inside a track: "finish arrays", "ship the auth flow".
// Unlike goals these are ticked once and stay ticked, and the share of them
// done is the track's completion percentage.
model Checkpoint {
  id        String    @id @default(cuid())
  trackId   String
  track     Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  title     String
  doneAt    DateTime?
  // The owner's local date when it was finished, which is what decides the
  // day a fully finished track stops being due.
  doneOn    String?
  checkIns  CheckIn[]
  // Where it sits in the track's list. The owner can drag them into any order.
  position  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([trackId])
}

model Goal {
  id        String    @id @default(cuid())
  trackId   String
  track     Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  title     String
  emoji     String?
  startsOn  String
  createdAt DateTime  @default(now())
  checkIns  CheckIn[]
  subtasks  Subtask[]

  @@index([trackId])
}

// A mini task inside a goal. A goal with subtasks is done for the day once
// every one of them is ticked.
model Subtask {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title     String
  // The last day it was ticked. Subtasks start fresh every day, so it only
  // counts as done while this is today; the history lives in CheckIn.
  doneOn    String?
  createdAt DateTime @default(now())

  @@index([goalId])
}

model CheckIn {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  date      String
  // The checkpoint the day's work went towards.
  checkpointId String?
  checkpoint   Checkpoint? @relation(fields: [checkpointId], references: [id], onDelete: SetNull)
  // Proof of the work: the path of a photo in the "proofs" storage bucket,
  // and optionally a line about it. The photo is private: only its owner and
  // an admin can ever open it.
  photo     String?
  note      String?
  link      String?
  createdAt DateTime @default(now())
  reactions Reaction[]

  @@unique([goalId, date])
  @@index([createdAt])
}

// A friend's one-tap response to a commit. One of each emoji per person.
model Reaction {
  id        String   @id @default(cuid())
  checkInId String
  checkIn   CheckIn  @relation(fields: [checkInId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([checkInId, userId, emoji])
}

// One browser or installed app that has agreed to receive reminders. The
// endpoint and keys are what the browser handed over; the timezone is how the
// server knows what time it is for this person.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  timezone  String
  createdAt DateTime @default(now())

  @@index([userId])
}

// One row per pair of users. It is a pending request until accepted.
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User     @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  accepted    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

// One thing that happened: an API request the server answered, something a
// browser reported (a failed upload, a request that never got through, a
// crash), or something the server did on its own. Admins read these to work
// out what went wrong for someone. Kept for 30 days.
model Log {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  // "request", "client" or "server"
  source    String
  // "info", "warn" or "error"
  level     String
  // What happened, in a few words: "PUT /tracks/abc/checkin" or "photo upload failed".
  event     String
  message   String?
  // Who it happened to, when they were signed in. Not a relation, so a
  // report can be filed for someone who hasn't finished signing up; an
  // account's logs are deleted along with it.
  userId    String?
  method    String?
  path      String?
  status    Int?
  // How long it took.
  ms        Int?
  // Which address the site was opened on, and from what.
  host      String?
  userAgent String?
  ip        String?
  // Anything else worth knowing, as the reporter gave it.
  detail    Json?

  @@index([at])
  @@index([userId, at])
  @@index([level, at])
}
